[Unit]
Description=Gitea Runner (CI Blue team, mode hôte)
Documentation=https://gitea.com/gitea/runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ci
Group=ci
WorkingDirectory=/var/lib/gitea-runner
Environment=HOME=/var/lib/gitea-runner
# Machine propre au démarrage aussi (job interrompu par un redémarrage)
ExecStartPre=/usr/local/libexec/gitea-ci-nettoyage
ExecStart=/usr/local/bin/gitea-runner -c /etc/gitea-runner/config.yaml daemon
Restart=always
RestartSec=10
TimeoutStopSec=35min
KillMode=mixed
# Pas de NoNewPrivileges : Podman sans privilèges passe par newuidmap (setuid)
PrivateTmp=true
ProtectSystem=full
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/gitea-runner /var/log/gitea-runner

[Install]
WantedBy=multi-user.target
