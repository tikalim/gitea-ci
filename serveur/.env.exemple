# Copier en .env (jamais versionné) et adapter.
# Nom (ou adresse IP) sous lequel le runner et les navigateurs joignent Gitea ; il figure dans le certificat HTTPS.
GITEA_DOMAIN=gitea-ci.interne.exemple
# Interface d'écoute sur l'hôte : l'adresse du réseau interne de la machine (jamais 0.0.0.0 sur une machine exposée)
GITEA_BIND=127.0.0.1
GITEA_PORT=3000
# Destinations admises pour les miroirs (format ALLOWED_HOST_LIST de Gitea)
GITEA_MIRROR_HOSTS=github.com
# Proxy sortant vers GitHub, si la machine n'a pas d'accès direct
GITEA_PROXY_ENABLED=false
GITEA_PROXY_URL=
# github.com ET ses sous-domaines (api.github.com…) : sans *.github.com, les appels de Gitea sortent en direct et échouent
GITEA_PROXY_HOSTS=github.com,*.github.com
# Réseaux du déploiement (hors 172.x, comme les plateformes)
GITEA_NET_INTERNE=192.168.251.96/28
GITEA_NET_SORTIE=192.168.251.112/28
